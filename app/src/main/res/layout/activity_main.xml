<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#040303"
    android:foregroundTint="#040404"
    tools:context=".MainActivity">

    <SurfaceView
        android:id="@+id/gameView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.727" />

    <com.example.untitleddungeongame.ui.Arrows
        android:id="@+id/arrows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:visibility="gone"/>


    <com.example.untitleddungeongame.ui.CustomDialog
        android:id="@+id/combat_dialog"
        android:layout_width="404dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toTopOf="@+id/item_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />


    <com.example.untitleddungeongame.ui.hotbar.HotBar
        android:id="@+id/attack_bar"
        android:layout_width="334dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/itemAttackButton"
        app:layout_constraintDimensionRatio="16:4"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.506"
        app:layout_constraintStart_toStartOf="parent" />

    <com.example.untitleddungeongame.ui.hotbar.HotBar
        android:id="@+id/item_bar"
        android:layout_width="334dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/itemAttackButton"
        app:layout_constraintDimensionRatio="16:4"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.506"
        app:layout_constraintStart_toStartOf="parent" />


    <com.example.untitleddungeongame.ui.PauseMenu
        android:id="@+id/pause_menu"
        android:layout_width="416dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.untitleddungeongame.ui.hotbar.ItemAttackButton
        android:id="@+id/itemAttackButton"
        android:layout_width="300dp"
        android:layout_height="65dp"
        android:layout_marginTop="500dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.untitleddungeongame.ui.ConfirmCancelMenu
        android:id="@+id/confirm_cancel"
        android:layout_width="300dp"
        android:layout_height="65dp"
        android:layout_marginTop="500dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.untitleddungeongame.ui.PixelButton
        android:id="@+id/pause_button"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="36dp"
        android:text=""
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:resource="BUTTON_PAUSE" />

    <com.example.untitleddungeongame.ui.PixelButton
        android:id="@+id/map_button"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:text=""
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="@+id/pause_button"
        app:layout_constraintTop_toBottomOf="@+id/pause_button"
        app:resource="MAP"

        />

</androidx.constraintlayout.widget.ConstraintLayout>