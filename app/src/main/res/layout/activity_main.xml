<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#040303"
    android:foregroundTint="#040404"
    tools:context=".MainActivity">

    <SurfaceView
        android:id="@+id/gameView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.727" />

    <ImageView
        android:id="@+id/attack_button"
        android:layout_width="@dimen/button_default_width"
        android:layout_height="@dimen/button_default_height"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="75dp"
        android:src="@drawable/button_state"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/combat_dialog" />

    <ImageView
        android:id="@+id/items_button"
        android:layout_width="@dimen/button_default_width"
        android:layout_height="@dimen/button_default_height"
        android:layout_marginEnd="40dp"
        android:src="@drawable/button_state"
        app:layout_constraintBottom_toBottomOf="@+id/attack_button"
        app:layout_constraintEnd_toEndOf="@+id/combat_dialog"
        app:layout_constraintTop_toTopOf="@+id/attack_button"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/player_health"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        android:layout_marginTop="40dp"
        android:text="TextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/enemy_health"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="184dp"
        android:text="TextView"
        app:layout_constraintBottom_toBottomOf="@+id/player_health"
        app:layout_constraintStart_toEndOf="@+id/player_health" />

    <Button
        android:id="@+id/pause"
        android:layout_width="54dp"
        android:layout_height="66dp"
        android:layout_marginStart="316dp"
        android:layout_marginTop="64dp"
        android:onClick="onUserPause"
        android:text="| |"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.untitleddungeongame.ui.CustomDialog
        android:id="@+id/combat_dialog"
        android:layout_width="404dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="108dp"
        app:layout_constraintBottom_toTopOf="@+id/item_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.428"
        app:layout_constraintStart_toStartOf="parent" />

    <com.example.untitleddungeongame.ui.hotbar.HotBar
        android:id="@+id/item_bar"
        android:layout_width="334dp"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/items_button"
        app:layout_constraintDimensionRatio="16:4"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintHorizontal_bias="0.415"
        app:layout_constraintStart_toStartOf="parent" />
    <com.example.untitleddungeongame.ui.hotbar.HotBar
        android:id="@+id/attack_bar"
        android:layout_width="334dp"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/attack_button"
        app:layout_constraintDimensionRatio="16:4"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintHorizontal_bias="0.415"
        app:layout_constraintStart_toStartOf="parent" />


    <com.example.untitleddungeongame.ui.Arrows
        android:id="@+id/arrows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:visibility="gone">

    </com.example.untitleddungeongame.ui.Arrows>

    <ImageView
        android:id="@+id/pauseVisual"
        android:layout_width="52dp"
        android:layout_height="66dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/buttonpause" />

    <TextView
        android:id="@+id/attacks_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Attacks"
        android:textColor="@color/white"
        android:textSize="@dimen/button_default_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/attack_button"
        app:layout_constraintEnd_toEndOf="@+id/attack_button"
        app:layout_constraintStart_toStartOf="@+id/attack_button"
        app:layout_constraintTop_toTopOf="@+id/attack_button" />

    <TextView
        android:id="@+id/items_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Items"
        android:textColor="@color/white"
        android:textSize="@dimen/button_default_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/items_button"
        app:layout_constraintEnd_toEndOf="@+id/items_button"
        app:layout_constraintStart_toStartOf="@+id/items_button"
        app:layout_constraintTop_toTopOf="@+id/items_button" />

    <com.example.untitleddungeongame.ui.PauseMenu
        android:id="@+id/pause_menu"
        android:layout_width="416dp"
        android:layout_height="141dp"
        android:layout_marginTop="165dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pause" />

</androidx.constraintlayout.widget.ConstraintLayout>