<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#040303"
    android:foregroundTint="#040404"
    tools:context=".MainActivity">

    <SurfaceView
        android:id="@+id/gameView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.untitleddungeongame.ui.Arrows
        android:id="@+id/arrows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone"></com.example.untitleddungeongame.ui.Arrows>

    <Button
        android:id="@+id/pause"
        android:layout_width="54dp"
        android:layout_height="66dp"
        android:layout_marginStart="316dp"
        android:layout_marginTop="64dp"
        android:onClick="onUserPause"
        android:text="| |"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.untitleddungeongame.ui.CustomDialog
        android:id="@+id/combat_dialog"
        android:layout_width="404dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="108dp"
        app:layout_constraintBottom_toTopOf="@+id/item_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.428"
        app:layout_constraintStart_toStartOf="parent" />

        <com.example.untitleddungeongame.ui.hotbar.HotBar
        android:id="@+id/attack_bar"
        android:layout_width="334dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/itemAttackButton"
        app:layout_constraintDimensionRatio="16:4"
        android:layout_marginBottom="56dp"


        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />


    <com.example.untitleddungeongame.ui.hotbar.HotBar
        android:id="@+id/item_bar"
        android:layout_width="334dp"
        android:layout_height="0dp"
        android:layout_marginBottom="56dp"
        app:layout_constraintBottom_toTopOf="@+id/itemAttackButton"

        app:layout_constraintDimensionRatio="16:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <com.example.untitleddungeongame.ui.PauseMenu
        android:id="@+id/pause_menu_main"
        android:layout_width="219dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </com.example.untitleddungeongame.ui.PauseMenu>

    <ImageView
        android:id="@+id/pauseVisual"
        android:layout_width="52dp"
        android:layout_height="66dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/buttonpause" />



    <ImageView
        android:id="@+id/map"
        android:layout_width="59dp"
        android:layout_height="56dp"
        android:layout_marginTop="140dp"
        android:layout_marginEnd="36dp"
        android:onClick="mapButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/minimapbutton" />

    <com.example.untitleddungeongame.ui.hotbar.ItemAttackButton
        android:id="@+id/itemAttackButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="84dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintDimensionRatio="16:3.25"
        app:layout_constraintHorizontal_bias="0.5"/>

</androidx.constraintlayout.widget.ConstraintLayout>