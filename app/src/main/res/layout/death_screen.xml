<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/death_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.untitleddungeongame.ui.DeathScreen">

    <ImageView
        android:id="@+id/retry"
        android:layout_width="209dp"
        android:layout_height="95dp"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="108dp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/youDiedText"
        app:srcCompat="@drawable/button" />

    <ImageView
        android:id="@+id/backToMainMenu"
        android:layout_width="209dp"
        android:layout_height="95dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="108dp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/retry"
        app:srcCompat="@drawable/button" />

    <TextView
        android:id="@+id/youDiedText"
        android:layout_width="143dp"
        android:layout_height="99dp"
        android:layout_marginTop="236dp"
        android:layout_marginEnd="148dp"
        android:text="You Died"
        android:textAlignment="center"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/deathNewRun"
        android:layout_width="157dp"
        android:layout_height="55dp"
        android:onClick="restartGame"
        android:text="New Run"
        android:textAlignment="center"
        android:textColorLink="@color/white"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="@+id/retry"
        app:layout_constraintEnd_toEndOf="@+id/retry"
        app:layout_constraintStart_toStartOf="@+id/retry"
        app:layout_constraintTop_toTopOf="@+id/retry" />

    <TextView
        android:id="@+id/deathMainMenu"
        android:layout_width="159dp"
        android:layout_height="88dp"
        android:onClick="onQuit"
        android:text="Main Menu"
        android:textAlignment="center"
        android:textColorLink="@color/white"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="@+id/backToMainMenu"
        app:layout_constraintEnd_toEndOf="@+id/backToMainMenu"
        app:layout_constraintStart_toStartOf="@+id/backToMainMenu"
        app:layout_constraintTop_toTopOf="@+id/backToMainMenu" />
</androidx.constraintlayout.widget.ConstraintLayout>