<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_attack_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/attack_button"
        android:layout_width="@dimen/button_default_width"
        android:layout_height="@dimen/button_default_height"
        android:layout_marginStart="40dp"
        android:src="@drawable/button_state"
        app:layout_constraintStart_toStartOf="@+id/combat_dialog"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/items_button"
        android:layout_width="@dimen/button_default_width"
        android:layout_height="@dimen/button_default_height"
        android:src="@drawable/button_state"
        app:layout_constraintBottom_toBottomOf="@+id/attack_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/attack_button"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/attacks_text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Attacks"
        android:textColor="@color/white"
        android:textSize="@dimen/button_default_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/attack_button"
        app:layout_constraintEnd_toEndOf="@+id/attack_button"
        app:layout_constraintStart_toStartOf="@+id/attack_button"
        app:layout_constraintTop_toTopOf="@+id/attack_button" />

    <TextView
        android:id="@+id/items_text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Items"
        android:textColor="@color/white"
        android:textSize="@dimen/button_default_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/items_button"
        app:layout_constraintEnd_toEndOf="@+id/items_button"
        app:layout_constraintStart_toStartOf="@+id/items_button"
        app:layout_constraintTop_toTopOf="@+id/items_button" />
</androidx.constraintlayout.widget.ConstraintLayout>