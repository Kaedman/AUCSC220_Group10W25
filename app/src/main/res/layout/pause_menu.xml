<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pause_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.untitleddungeongame.ui.PauseMenu">

    <ImageView
        android:id="@+id/resume_button"
        android:layout_width="@dimen/button_pause_menu_width"
        android:layout_height="@dimen/button_default_height"
        android:scaleType="fitXY"
        android:src="@drawable/button_state"
        android:text="resume"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/quit_button"
        android:layout_width="@dimen/button_pause_menu_width"
        android:layout_height="@dimen/button_default_height"
        android:scaleType="fitXY"
        android:src="@drawable/button_state"
        android:text="quit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/resume_button" />

    <TextView
        android:id="@+id/resume_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/button_state"
        android:text="Resume"
        android:textColor="@color/white"
        android:textSize="@dimen/button_default_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/resume_button"
        app:layout_constraintEnd_toEndOf="@+id/resume_button"
        app:layout_constraintStart_toStartOf="@+id/resume_button"
        app:layout_constraintTop_toTopOf="@+id/resume_button" />

    <TextView
        android:id="@+id/quit_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/button_state"
        android:text="Quit"
        android:textColor="@color/white"
        android:textSize="@dimen/button_default_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/quit_button"
        app:layout_constraintEnd_toEndOf="@+id/quit_button"
        app:layout_constraintStart_toStartOf="@+id/quit_button"
        app:layout_constraintTop_toTopOf="@id/quit_button" />
</androidx.constraintlayout.widget.ConstraintLayout>